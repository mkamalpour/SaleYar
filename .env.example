# ─────────────────────────────────────────────────────────────
# SaleYar — environment configuration
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# `.env` is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ---------- API AUTHENTICATION ----------
# Required by every API endpoint (sent as the `X-API-Key` header).
# Leave blank to generate a private local key, or set a strong custom key.
API_KEY=

# ---------- LLM ADVISOR (OPTIONAL) ----------
# Leave LLM_ENABLED=false to use the built-in offline keyword advisor.
LLM_ENABLED=false

# Point at a local OpenAI-compatible server (LM Studio, Ollama, llama.cpp).
LLM_ENDPOINT_URL=http://localhost:1234/v1/chat/completions
LLM_MODEL_NAME=your-local-model
LLM_TIMEOUT_SECONDS=15
