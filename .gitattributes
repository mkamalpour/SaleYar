# Normalise line endings in the repository; check out with the platform default.
* text=auto

*.py   text diff=python
*.md   text
*.txt  text
*.html text
*.css  text
*.js   text
*.json text
*.yml  text
*.yaml text

# Never touch line endings in these.
*.csv   -text
*.xlsx  binary
*.pdf   binary
*.pkl   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.woff2 binary
